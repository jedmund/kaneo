{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"GITLAB_INTERNAL_URL",
		"GITLAB_OAUTH_CLIENT_ID",
		"GITLAB_OAUTH_CLIENT_SECRET",
		"GITLAB_PUBLIC_URL",
		"KANEO_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS",
		"SCM_SECRET_ENCRYPTION_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"@kaneo/site#build": {
			"outputs": [".next/**", "!.next/cache/**", "out/**"]
		},

		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		}
	}
}
